{
  "description": "Load repository-local context when a Codex session starts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "additionalContextLimit": 10000,
            "command": "\"$HOME/.nix-profile/bin/agent-local-context\" codex",
            "statusMessage": "Loading repository-local context",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
