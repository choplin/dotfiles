#!/bin/sh

set -eu

resolve_herdr_bin() (
  socket_path=${HERDR_SOCKET_PATH:-}

  # Prefer the server's loaded binary so its private CLI protocol stays compatible.
  if [ -n "$socket_path" ] && command -v lsof >/dev/null 2>&1; then
    cache_path=${socket_path}.herdr-open-bin
    cached_pid=
    cached_bin=
    if [ -r "$cache_path" ] && [ "$cache_path" -nt "$socket_path" ] && {
      IFS= read -r cached_pid &&
        IFS= read -r cached_bin
    } <"$cache_path"; then
      case "$cached_pid" in
        '' | *[!0-9]*) ;;
        *)
          if kill -0 "$cached_pid" 2>/dev/null &&
            [ "${cached_bin##*/}" = herdr ] && [ -x "$cached_bin" ]; then
            printf '%s\n' "$cached_bin"
            return
          fi
          ;;
      esac
    fi

    server_pid=$(lsof -n -t "$socket_path" 2>/dev/null | sed -n '1p')
    if [ -n "$server_pid" ]; then
      server_bin=$(
        lsof -n -a -p "$server_pid" -d txt -F n 2>/dev/null |
          sed -n 's/^n//p' |
          while IFS= read -r candidate; do
            if [ "${candidate##*/}" = herdr ] && [ -x "$candidate" ]; then
              printf '%s\n' "$candidate"
              break
            fi
          done
      )
      if [ -n "$server_bin" ]; then
        cache_tmp=${cache_path}.$$
        if (umask 077; printf '%s\n%s\n' "$server_pid" "$server_bin" >"$cache_tmp") 2>/dev/null; then
          mv -f "$cache_tmp" "$cache_path" 2>/dev/null || {
            rm -f "$cache_tmp" 2>/dev/null || :
          }
        else
          rm -f "$cache_tmp" 2>/dev/null || :
        fi
        printf '%s\n' "$server_bin"
        return
      fi
    fi
  fi

  printf '%s\n' "${HERDR_BIN_PATH:-herdr}"
)

herdr_bin=$(resolve_herdr_bin)
target_pane_id=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}

main() (
  [ "$#" -ge 1 ] || usage

  placement=$1
  shift

  if [ -z "$target_pane_id" ]; then
    echo "herdr-open: no active Herdr pane" >&2
    exit 1
  fi

  cwd=$(resolve_cwd)

  case "$placement" in
    pane)
      [ "$#" -ge 1 ] || usage
      run_in_pane "$cwd" "$@"
      ;;
    tab)
      open_tab "$cwd" "$@"
      ;;
    split)
      [ "$#" -ge 1 ] || usage
      direction=$1
      shift
      validate_direction "$direction"
      if [ "$#" -eq 0 ]; then
        open_empty_split "$direction" "$cwd"
      else
        open_command_split "$direction" "$cwd" "$@"
      fi
      ;;
    *) usage ;;
  esac
)

usage() {
  cat >&2 <<'EOF'
usage:
  herdr-open pane <command> [args...]
  herdr-open tab [command [args...]]
  herdr-open split <right|down> [command [args...]]
EOF
  exit 2
}

resolve_cwd() (
  cwd=${HERDR_ACTIVE_PANE_CWD:-}

  if pane_json=$("$herdr_bin" pane get "$target_pane_id" 2>/dev/null); then
    reported_cwd=$(printf '%s\n' "$pane_json" | jq -r '.result.pane.cwd // empty')
    if [ -n "$reported_cwd" ]; then
      cwd=$reported_cwd
    fi
  fi

  if [ ! -d "$cwd" ]; then
    cwd=
  fi

  printf '%s\n' "$cwd"
)

run_in_pane() (
  cwd=$1
  shift

  if [ -n "$cwd" ]; then
    cd "$cwd"
  fi
  exec "$@"
)

create_tab() (
  cwd=$1

  set -- tab create
  if [ -n "$workspace_id" ]; then
    set -- "$@" --workspace "$workspace_id"
  fi
  if [ -n "$cwd" ]; then
    set -- "$@" --cwd "$cwd"
  fi
  "$herdr_bin" "$@" --focus
)

open_tab() (
  cwd=$1
  shift

  if [ "$#" -eq 0 ]; then
    create_tab "$cwd"
    return
  fi

  create_result=$(create_tab "$cwd")
  created_pane_id=$(printf '%s\n' "$create_result" | jq -r '.result.root_pane.pane_id // empty')
  if [ -z "$created_pane_id" ]; then
    echo "herdr-open: Herdr did not report the created pane" >&2
    exit 1
  fi

  exec "$herdr_bin" pane run "$created_pane_id" "$@"
)

open_empty_split() (
  split_direction=$1
  cwd=$2

  set -- pane split \
    --pane "$target_pane_id" \
    --direction "$split_direction"
  if [ -n "$cwd" ]; then
    set -- "$@" --cwd "$cwd"
  fi
  "$herdr_bin" "$@" --focus
)

open_command_split() (
  split_direction=$1
  cwd=$2
  shift 2

  split_command=$(jq -nr --args '$ARGS.positional | map(@sh) | join(" ")' -- "$@")

  set -- plugin pane open \
    --plugin choplin.split-pane \
    --entrypoint command \
    --placement split \
    --target-pane "$target_pane_id" \
    --direction "$split_direction"
  if [ -n "$cwd" ]; then
    set -- "$@" --cwd "$cwd"
  fi
  set -- "$@" --env "HERDR_SPLIT_COMMAND=$split_command" --focus
  exec "$herdr_bin" "$@"
)

validate_direction() {
  case "$1" in
    right | down) ;;
    *) usage ;;
  esac
}

main "$@"
