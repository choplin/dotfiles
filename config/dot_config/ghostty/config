font-family = "UDEV Gothic NF"
font-size = 18

theme = Duskfox
background-opacity = 0.97
background-blur = 20
window-padding-x = 10

shell-integration = zsh
auto-update = check

# Forward Cmd+T to terminal applications such as Herdr.
keybind = super+t=unbind
# Forward Cmd+Shift+T to terminal applications such as Herdr.
keybind = super+shift+t=unbind
# Forward Cmd+N to terminal applications such as Herdr.
keybind = super+n=unbind
keybind = super+shift+n=new_window
# Forward Cmd+D to terminal applications such as Herdr.
keybind = super+d=unbind
